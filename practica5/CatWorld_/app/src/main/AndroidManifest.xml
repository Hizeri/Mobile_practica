<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешаем приложению использовать интернет -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Основные настройки приложения -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CatWorld">

        <!-- Экран подробной информации о выбранной породе -->
        <activity
            android:name=".BreedDetailsActivity"
            android:exported="false" />

        <!-- Экран каталога пород с RecyclerView -->
        <activity
            android:name=".BreedListActivity"
            android:exported="false" />

        <!-- Главный экран приложения CatWorld -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Экран входа и регистрации пользователя -->
        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Экран авторизации запускается первым -->
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>
