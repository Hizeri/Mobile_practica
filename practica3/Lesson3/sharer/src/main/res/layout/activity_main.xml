<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FAF8FC">

    <!-- Заголовок приложения -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Практическая №3 — Sharer"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#6750A4"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Описание задания -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Задание 1.6 — Обмен данными"
        android:textSize="16sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="28dp"/>

    <!-- Отправка текста -->
    <Button
        android:id="@+id/buttonShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Поделиться текстом"
        android:backgroundTint="#6750A4"
        android:textColor="#FFFFFF"/>

    <!-- Выбор изображения -->
    <Button
        android:id="@+id/buttonPick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбрать изображение"
        android:backgroundTint="#6750A4"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"/>

    <!-- Здесь появится результат выбора -->
    <TextView
        android:id="@+id/textResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Результат появится здесь"
        android:textSize="15sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginTop="30dp"/>

</LinearLayout>
