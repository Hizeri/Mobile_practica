<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Название приложения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CatWorld"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Показ списка пород -->
        <Button
            android:id="@+id/buttonGetBreeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показать породы кошек" />

        <!-- Поле поиска -->
        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите название породы"
            android:inputType="text" />

        <!-- Кнопка поиска -->
        <Button
            android:id="@+id/buttonSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Найти породу" />

        <!-- Карточка породы -->
        <Button
            android:id="@+id/buttonDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показать карточку Бенгальской кошки" />

        <!-- Добавление в избранное -->
        <Button
            android:id="@+id/buttonAddFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить Бенгальскую кошку в избранное" />

        <!-- Просмотр избранного -->
        <Button
            android:id="@+id/buttonShowFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показать избранное" />

        <!-- Удаление из избранного -->
        <Button
            android:id="@+id/buttonDeleteFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить Бенгальскую кошку из избранного" />

        <!-- Тестовое распознавание -->
        <Button
            android:id="@+id/buttonRecognize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Распознать породу по фото" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Выйти" />

        <!-- Вывод результата -->
        <TextView
            android:id="@+id/textViewResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Результат"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>