<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8FC"
    android:padding="16dp">

    <!-- Кнопка возвращения -->
    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Назад в CatWorld"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6750A4" />

    <!-- Название каталога -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CatWorld — Породы кошек"
        android:textColor="#6750A4"
        android:textSize="23sp"
        android:textStyle="bold" />

    <!-- Количество пород -->
    <TextView
        android:id="@+id/emptyBreeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="Загрузка пород..."
        android:textColor="#555555"
        android:textSize="14sp" />

    <!-- Список карточек с фотографиями -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/breedsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
