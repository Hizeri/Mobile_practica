<?xml version="1.0" encoding="utf-8"?>
<!-- Один экран: заголовок, статус сети, обновление, настройки фото и список. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retrofit и Picasso"
        android:textColor="@color/purple"
        android:textStyle="bold"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Подключение к серверу…"
        android:textColor="@color/body_text"
        android:textSize="13sp" />

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ОБНОВИТЬ СПИСОК"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple" />

    <!-- Переключатель меняет параметры масштабирования Picasso. -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/imageSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:text="Изображения: центрировать и обрезать"
        android:textSize="13sp"
        android:textColor="@color/body_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/todoRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
