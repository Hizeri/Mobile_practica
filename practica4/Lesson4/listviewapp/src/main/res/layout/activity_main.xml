<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#FAF8FC">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="35 книг на ближайшие 30 лет" android:textSize="21sp"
        android:textStyle="bold" android:padding="10dp" />
    <!-- ListView использует ArrayAdapter, а не 35 отдельных TextView -->
    <ListView android:id="@+id/booksList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
