<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF8FC">

    <!-- Основной контейнер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мир кошек"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="8dp"/>

        <!-- Описание раздела -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Узнай больше об удивительных породах кошек"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp"/>

        <!-- Карточка бенгальской кошки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#EDE7F6"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Бенгальская кошка"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#4527A0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Бенгальские кошки отличаются пятнистой шерстью, напоминающей окрас леопарда. Они активные, любознательные и любят играть."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- Карточка мейн-куна -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#EDE7F6"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мейн-кун"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#4527A0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мейн-куны — крупные домашние кошки с густой шерстью и пушистым хвостом. Они известны дружелюбным характером."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- Карточка сиамской кошки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#EDE7F6">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сиамская кошка"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#4527A0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сиамские кошки отличаются голубыми глазами и характерным окрасом. Они общительные, умные и очень привязаны к хозяевам."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
