<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FAF8FC">

    <!-- Заголовок задания -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Практическая №3 Фрагменты"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#6750A4"
        android:gravity="center"
        android:padding="12dp"/>

    <!-- Контейнер первого или выбранного фрагмента -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Второй контейнер нужен для поворота устройства -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/secondContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <!-- Кнопки переключения экранов -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnFirstFragment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Первый экран"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnSecondFragment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Второй экран"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>
